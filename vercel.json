{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "//git": "Só o branch `deploy` (produção) faz deploy. Pushes a `main` (~70/dia dos bots de refresh) NÃO criam deployment — evita esgotar o limite de ~100 deploys/dia do plano free. O branch `deploy` é avançado 4x/dia por .github/workflows/deploy-branch.yml. IMPORTANTE: no dashboard Vercel, Production Branch tem de ser `deploy`.",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "buildCommand": "COSMATH_DEPLOY_BUILD=1 node --max-old-space-size=4096 scripts/inject-seed-into-demo.js",
  "outputDirectory": ".",
  "installCommand": "echo 'no install needed'",
  "framework": null,
  "cleanUrls": true,
  "redirects": [
    { "source": "/demo.html", "destination": "/", "permanent": false },
    { "source": "/demo", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/((?!.*\\.).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
